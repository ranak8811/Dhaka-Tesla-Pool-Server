# Dhaka Tesla Pool - Backend Environment Variables
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
# For local host development:
DATABASE_URL="postgresql://tesla_admin:tesla_secret_password@localhost:5432/dhaka_tesla_pool?schema=public"
# For Docker Compose orchestration:
# DATABASE_URL="postgresql://tesla_admin:tesla_secret_password@postgres:5432/dhaka_tesla_pool?schema=public"

# Database Credentials for Docker Compose
POSTGRES_USER=tesla_admin
POSTGRES_PASSWORD=tesla_secret_password
POSTGRES_DB=dhaka_tesla_pool

# Authentication & Security
JWT_SECRET="dhaka_tesla_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"
